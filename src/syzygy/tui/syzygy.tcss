/* Syzygy's visual identity (docs/old/DESIGN.md section 18).
 *
 * A near-black field, warm bone text, bright white for the calculated
 * (astrology, correspondences), lunar blue for the structural, oxidized
 * red for warnings, and one high-energy ember accent reserved for chance
 * and reveal - the ember is never used for anything the machine
 * calculated, only for what it did not.
 *
 * Color is never the sole carrier of meaning: states also change glyph,
 * label, or key hint.
 */

$syz-field: #0a0b0d;
$syz-panel: #131417;
$syz-bone: #e6ddc9;
$syz-muted: #8a8272;
$syz-dim: #4a4438;
/* The calculated-fact accent (M12.1). Was a solar gold (#cf9b3f); now a
 * true white, which reads as *brighter* than $syz-bone body text rather
 * than as another warm tone competing with it. Named for its role, not
 * its colour, so the next change is one line. */
$syz-accent: #ffffff;
$syz-lunar: #7ea6c9;
$syz-oxide: #8f3a2a;
$syz-ember: #ff4d1f;

Screen {
    background: $syz-field;
    color: $syz-bone;
    layout: vertical;
}

.hidden {
    display: none;
}

.summary-panel {
    height: auto;
    max-height: 12;
    padding: 1 2;
    border-top: solid $syz-dim;
    color: $syz-bone;
}

.startup-mark {
    height: 1;
    width: 100%;
    text-align: center;
    color: $syz-bone;
    text-style: bold;
}

.particles {
    height: 1;
    width: 100%;
    text-align: center;
    color: $syz-ember;
    text-style: bold;
}

.-anim-flash {
    background: $syz-dim;
}

.-anim-success {
    color: $syz-bone;
    text-style: bold;
}

.-anim-error {
    color: $syz-ember;
    text-style: bold;
}

/* Layout tiers (M12.5d).
 *
 * `syzygy.tui.screens.base` owns the thresholds - it is the one place
 * they are written down - and sets the classes styled here:
 *
 *   -compact   below 100x32, at or above the 80x24 floor. Padding
 *              shrinks; layout and content do not change shape, so
 *              nothing here can hide information, only the whitespace
 *              around it (docs/old/DESIGN.md section 18.6).
 *   (none)     100x32 to 119 columns. One column, full height.
 *   -wide      120 columns and up. Screens go multi-column.
 *
 * The rule for every `-wide` block below: it rearranges widgets that
 * already exist at the narrow tier. A wide layout never adds content a
 * narrow terminal cannot reach, and never removes any.
 */

.-compact .title-bar,
.-compact .lede,
.-compact .muted {
    padding: 0 1;
}

.-compact #chart-body,
.-compact #chart-aspects-body,
.-compact #cosmos-sky-body,
.-compact #cosmos-transits-body,
.-compact #archive-frequency {
    padding: 0 1;
}

/* At the floor every row counts: the stacked home regions plus their
 * headings are taller than 80x24 has to spare, and the rows lost here are
 * blank ones. Nothing is hidden - `#home-columns` scrolls, and the
 * padding is whitespace, not content. */
.-compact .column-heading,
.-compact #home-chart-hint,
.-compact #home-sky-hint,
.-compact #home-transits,
.-compact #home-anchors {
    padding: 0 1;
}

.-compact #primary-action {
    margin: 0;
}

/* At the floor the reading screen's three key rows and their padding cost
 * more than the interpretation they sit under is given. */
.-compact #reading-keys {
    padding: 0 1;
}

/* Two content rows and no frame around them. The axis says exactly as
 * much as it does at any other size; only its breathing room goes. */
.-compact AlignmentWidget {
    padding: 0 1;
    height: 2;
}

/* The heading over each stacked region. At `-wide` the regions sit under
 * the alignment axis's own SELF/COSMOS/CHANCE labels, which name them
 * from one row up; repeating the same three words directly underneath is
 * noise, so the axis does the labelling there and this does it when the
 * regions are stacked and the axis no longer points at anything.
 *
 * No vertical padding: stacked is the tier that is short of rows, and
 * three headings' worth of breathing room is what pushed the primary
 * action off the bottom at 100x32. */
.column-heading {
    color: $syz-accent;
    text-style: bold;
    padding: 0 2;
}

.-wide .column-heading {
    display: none;
}

.title-bar {
    width: 1fr;
    padding: 0 2;
    color: $syz-accent;
    text-style: bold;
    border-bottom: solid $syz-dim;
}

.lede {
    color: $syz-bone;
    text-style: bold;
    padding: 1 2 0 2;
}

.muted {
    color: $syz-muted;
    padding: 0 2;
}

.keys {
    color: $syz-lunar;
    padding: 1 2;
}

.error {
    color: $syz-ember;
    padding: 0 2;
}

.ok {
    color: $syz-lunar;
    padding: 0 2;
}

.section-heading {
    color: $syz-accent;
    text-style: bold;
    padding: 1 2 0 2;
}

.field-label {
    color: $syz-muted;
    padding: 1 2 0 2;
}

.button-row {
    height: auto;
    padding: 1 2;
}

Button {
    margin: 0 2 0 0;
}

/* The same answer to "where am I" as a highlighted list row (M17.4b).
 * Textual's own focus treatment is a text-style tweak on the label, which
 * on a row of three buttons is not enough to find the focused one at a
 * glance - and arrow-key navigation (M17.5) made that the question the
 * user asks most often. */
Button:focus {
    background: $syz-accent;
    color: $syz-panel;
    text-style: bold;
    border: tall $syz-accent;
}

Button:focus > .button--label {
    text-style: bold;
}

Footer {
    background: $syz-panel;
    color: $syz-muted;
}

Input {
    margin: 0 2;
    background: $syz-panel;
    border: tall $syz-dim;
}

Input:focus {
    border: tall $syz-accent;
}

#oracle-ask-body {
    width: 1fr;
    max-width: 90;
    height: 1fr;
    align: center middle;
    padding: 1 3;
}

#oracle-error,
#oracle-budget {
    height: auto;
}

#oracle-mode-buttons {
    width: auto;
    height: auto;
}

#oracle-result-columns {
    height: 1fr;
    padding: 0 2;
}

#oracle-result-aside {
    width: 34;
    height: 1fr;
}

#oracle-result-card {
    height: 16;
}

#oracle-result-transits {
    height: auto;
}

#oracle-result-main {
    width: 1fr;
    height: 1fr;
}

#oracle-result-question {
    height: auto;
    max-height: 4;
}

#oracle-result-panel {
    height: 1fr;
    padding: 1 2;
}

#oracle-result-body {
    width: 1fr;
    max-width: 88;
    height: auto;
}

#oracle-result-keys {
    height: auto;
}

.-compact #oracle-result-columns {
    padding: 0 1;
}

.-compact #oracle-result-aside {
    width: 24;
}

.-compact #oracle-result-card {
    height: 10;
}

#iching-result-columns {
    height: 1fr;
    padding: 0 2;
}

#iching-result-aside {
    width: 34;
    height: 1fr;
}

#iching-result-cast {
    height: auto;
    min-height: 10;
    text-align: center;
    color: $syz-accent;
    padding: 1;
}

#iching-result-transits {
    height: auto;
}

#iching-result-main {
    width: 1fr;
    height: 1fr;
}

#iching-result-question,
#iching-result-keys {
    height: auto;
}

#iching-result-question {
    max-height: 4;
}

#iching-result-panel {
    height: 1fr;
    padding: 1 2;
}

#iching-result-body {
    width: 1fr;
    max-width: 88;
    height: auto;
}

.-compact #iching-result-columns {
    padding: 0 1;
}

.-compact #iching-result-aside {
    width: 24;
}

ListView {
    background: $syz-field;
    padding: 0 2;
}

ListItem {
    background: $syz-field;
    color: $syz-bone;
    padding: 0 1;
}

/* Selection is a reversal, not a tint (M17.4a).
 *
 * It used to be `$syz-panel` on `$syz-field` - two neighbouring
 * near-blacks, which on the profile list was reported as too subtle to
 * see. The highlight now swaps the row's two colours outright, so it is
 * the single highest-contrast pair in the palette, and
 * `syzygy.tui.widgets.marked_list` puts a glyph in the row as well, for
 * the monochrome and colour-blind cases where contrast alone is not a
 * signal. Keep all three properties together: a highlight that is bold
 * *and* inverted *and* marked degrades one step at a time. */
ListItem.--highlight {
    background: $syz-accent;
    color: $syz-panel;
    text-style: bold;
}

ListView:focus ListItem.--highlight {
    background: $syz-accent;
    color: $syz-panel;
}

AlignmentWidget {
    /* Two content rows (labels + axis) plus one row of padding above and
       below - `height` is the whole box, padding included. */
    padding: 1 2;
    height: 4;
}

.transit-badge {
    width: auto;
    height: 1;
    margin: 0 2 0 0;
    color: $syz-accent;
}

.transit-badge.applying {
    text-style: bold;
}

.transit-badge.separating {
    color: $syz-muted;
}

TarotCardWidget {
    width: 33;
    height: 28;
    padding: 1 2;
    content-align: center middle;
    text-align: center;
    border: double $syz-accent;
    background: $syz-panel;
}

/* The animation bench (`syzygy dev animate`, M17.2e). Development-only
 * and unreachable from the application; it lives in this stylesheet so
 * what it demonstrates is styled exactly as the real screens are. */

#demo-columns {
    height: 1fr;
}

#demo-list {
    width: 40;
    border-right: solid $syz-dim;
}

#demo-stage {
    width: 1fr;
    padding: 1 2;
}

#demo-logo {
    width: 40;
    height: 6;
}

#demo-mascot {
    width: 20;
    height: 12;
}

/* Startup (M17.1). The opening sequence, on every launch. Sized like the
 * welcome screen's brand block because it is the same block - the logo
 * and the mascot both fall back to text or to nothing when the box is
 * too small for them, so these are budgets rather than frames. */

#startup-brand,
#welcome-brand {
    width: 64;
    height: auto;
    align: center middle;
}

#startup-middle {
    width: 1fr;
}

#startup-logo {
    width: 56;
    height: 6;
    margin: 0 4;
    content-align: center middle;
    color: $syz-accent;
}

#startup-mascot {
    width: 26;
    height: 20;
    margin: 0 19;
}

.-compact #startup-logo {
    width: 52;
    height: 6;
}

/* At the floor there are not 16 rows to give a decoration. */
.-compact #startup-mascot {
    display: none;
}

/* The mascot's reactive states (M17.3b). One asset, three treatments:
 * waiting is a resting half-presence, drawing recedes further because
 * attention belongs on the Wheel, and a finished reading brings it to
 * full strength. A mascot with no state set - the opening sequence, the
 * welcome copy - is decoration and gets none of these.
 *
 * Colour carries nothing here on purpose: the mascot is never the only
 * thing saying what state the day is in. The CHANCE column says it in
 * words a row above. */
Mascot.-mascot-waiting {
    opacity: 0.7;
}

Mascot.-mascot-drawing {
    opacity: 0.4;
}

Mascot.-mascot-complete {
    opacity: 1.0;
}

/* The home companion (M17.3a). Hidden by default and shown only where
 * there are columns or rows to spare: at the regular tier the CHANCE
 * column's rows belong to the status lines and the primary action. */
#home-mascot-slot {
    display: none;
    height: auto;
}

.-wide #home-mascot-slot,
.-tall #home-mascot-slot {
    display: block;
}

#home-mascot {
    width: 20;
    height: 14;
}

/* Welcome (brand assets: M12.2) */

#welcome-banner {
    color: $syz-accent;
    width: auto;
}

/* Both brand images size themselves to their box and fall back to text
 * when it is too small, so these are budgets rather than exact frames. */
#welcome-logo {
    width: 56;
    height: 6;
    margin: 0 4;
    content-align: center middle;
    color: $syz-accent;
}

#welcome-mascot {
    width: 26;
    height: 20;
    margin: 0 19;
}

.-compact #welcome-logo {
    width: 52;
    height: 6;
}

/* At the compact floor the mascot's rows are better reserved for the copy. */
.-compact #welcome-mascot {
    display: none;
}

/* Explicit, not `auto`: an auto-width child of an auto-width Horizontal
 * has nothing to resolve against and collapses to a few columns. */
#welcome-body {
    width: 56;
    height: auto;
    margin: 0 4;
    padding: 0;
    text-align: center;
}

/* Profile creation */

#profile-form {
    height: 1fr;
}

#profile-confirm {
    height: auto;
    padding: 1 0;
}

#confirm-body {
    padding: 0 2;
    color: $syz-bone;
}

/* Dev-only reroll (M11.6) - only ever visible with SYZYGY_DEV set. */

#home-dev {
    padding: 1 2 0 2;
}

#home-reroll-confirm {
    height: auto;
    padding: 1 0;
}

#reroll-body {
    padding: 0 2;
}

/* Local-model setup (M11.3) */

#model-body {
    height: 1fr;
}

#model-message {
    height: auto;
    max-height: 5;
}

#llama-form {
    height: auto;
    padding: 1 0;
}

#llama-help {
    padding: 1 2;
}

#llama-choice {
    height: auto;
    padding: 1 0;
}

/* The guided local-model wizard (M16.9).
 *
 * The body scrolls; the message line and the action row do not. That
 * split is the whole of M16.9e's "essential controls never fall below an
 * unreachable fold" - at the 80x24 compact floor the consent receipt is
 * far taller than the screen, and CONTINUE/BACK/CANCEL must still be
 * where they were.
 */
#setup-body {
    height: 1fr;
    padding: 0 1;
}

#setup-message {
    height: auto;
    max-height: 4;
}

#setup-actions {
    height: auto;
    dock: bottom;
}

#setup-progress {
    height: auto;
    padding: 1 0;
}

#setup-choices {
    height: auto;
    max-height: 18;
    margin: 1 0;
}

#setup-technical {
    padding: 1 2;
}

/* Compact: trim the wizard's padding rather than hide anything. Every
 * line in it either explains what will happen or is a control. */
.-compact #setup-body {
    padding: 0;
}

.-compact #setup-choices {
    max-height: 10;
}

.-compact #setup-technical {
    padding: 0 1;
}

/* Profile selection and deletion (M11.2) */

#profile-select-body {
    height: 1fr;
}

#profile-delete-confirm {
    height: auto;
    padding: 1 0;
}

#delete-body {
    padding: 0 2;
    color: $syz-bone;
}

/* Archive entry deletion uses the same cancel-first safety pattern as
 * profile deletion, but has its own ids because both screens are installed. */
#archive-body {
    height: 1fr;
}

#archive-delete-confirm {
    height: auto;
    padding: 1 0;
}

#archive-delete-body {
    padding: 0 2;
    color: $syz-bone;
}

/* Home (M12.5b).
 *
 * Three regions, one per point of the alignment axis above them. Stacked
 * below `WIDE_WIDTH` and in columns at or above it - the same widgets
 * either way, so `HomeScreen.compose` never asks how big the terminal is.
 */

/* Scrollable when stacked. At the 80x24 floor the three regions are
 * taller than the rows left over, and the one thing that must never be
 * unreachable is the primary action at the bottom of CHANCE. */
#home-columns {
    layout: vertical;
    height: 1fr;
    padding: 1 0 0 0;
    overflow-y: auto;
}

.home-column {
    width: 1fr;
    height: auto;
}

#home-anchors {
    height: auto;
    padding: 0 2;
}

/* One anchor per row, at every size. Side by side, the three ran to ~100
 * cells and the Ascendant fell off the right edge at the 80-column
 * floor. */
#home-anchors Glyph {
    width: 1fr;
    height: 1;
    color: $syz-lunar;
}

/* Tight by default, roomier at `-wide`. Stacked, all three regions share
 * one screen's rows and the padding between them is what runs the primary
 * action off the bottom; in columns each region has a column to itself
 * and the space is there to spend. */
#home-transits {
    height: auto;
    padding: 0 2;
}

#home-chart-hint,
#home-sky-hint {
    padding: 0 2;
}

#home-action {
    height: auto;
    padding: 0;
}

#primary-action {
    margin: 1 0;
    background: $syz-panel;
    color: $syz-ember;
    border: tall $syz-ember;
    text-style: bold;
}

#primary-action:hover {
    background: $syz-oxide;
    color: $syz-bone;
}

.-wide #home-columns {
    layout: horizontal;
    overflow-y: hidden;
}

/* Full-height columns with a rule between them. The regions share a top
 * baseline (centring each one independently made three ragged blocks at
 * three different heights), and the rules give the empty lower half a
 * structure - the space reads as three regions rather than as a screen
 * that ran out of things to say. */
.-wide .home-column {
    height: 1fr;
}

.-wide #home-cosmos,
.-wide #home-chance {
    border-left: solid $syz-dim;
}

.-wide #home-transits,
.-wide #home-chart-hint,
.-wide #home-sky-hint {
    padding: 1 2 0 2;
}

/* The wheel is what the screen is for: it takes what is left of the
 * CHANCE column and sits at the centre of it. */
.-wide #home-action {
    width: 1fr;
    height: 1fr;
    align: center middle;
}

/* The Wheel */

#wheel-body {
    height: 1fr;
}

#wheel {
    height: 1fr;
    min-height: 9;
}

#wheel-status {
    color: $syz-muted;
    text-align: center;
}

/* The card (M11.5).
 *
 * Explicit boxes, not `height: auto`. `TarotCardWidget` sizes its
 * illustration from its own cell box, so an auto-sized card would be
 * deciding its height from content whose height depends on that box.
 * Fixing the frame also stops the surrounding text reflowing every time
 * the terminal is resized. The art fills whatever is left after
 * `TarotCardWidget.TEXT_ROWS`, at the source illustration's own aspect
 * ratio, and falls back to the text card when the box gets too small.
 */

/* The reveal's card takes what is left after the caption, the transits
 * and the key hint, between a floor and a ceiling. A fixed height fit
 * none of the sizes it actually runs at: 28 rows overflowed the bottom
 * off both 100x32 and 120x40 while leaving a 55-row terminal two-thirds
 * empty. `1fr` between bounds is the whole fix - it can neither clip nor
 * leave a gap, at any size, without a per-size rule. */
#reveal-card {
    height: 100%;
}

/* Widened only when there are rows to spend on it: the art keeps the
 * illustration's aspect ratio, so beyond about 24 rows a 33-column frame
 * stops growing and just gains empty space. Bounded by rows, so `-tall`
 * rather than `-wide`. */
.-tall #reveal-card {
    width: 43;
}

.-compact #reveal-body {
    padding: 0;
}

.-compact #reveal-transits,
.-compact #reveal-hint {
    padding: 0 1;
}

/* Reading is not a card screen: the card is a fixed left column at
 * `-wide` and a header above the prose below it, and the interpretation
 * gets the slack. Stacked at the ideal 100x32, a 24-row card left the
 * reading itself two rows to scroll in. */
/* 22 is a measured floor, not a guess: the frame spends 4 rows on border
 * and padding and up to 8 on the card's own words (a long correspondence
 * label wraps), and `art_size_for` gives up below 9 rows of art. At 16
 * the reading screen showed a text-only card at every size below
 * `-wide`. */
#reading-card {
    height: 22;
}

.-compact #reading-card {
    height: 12;
}

.-wide #reading-card {
    height: 24;
}

/* Reveal.
 *
 * A ceremony, not a document: the card and its caption are centred in
 * whatever the screen has rather than stacked from the top edge, which
 * is what left two-thirds of a tall terminal blank below them.
 */

#reveal-body {
    height: 1fr;
    padding: 1 0;
}

#reveal-stage {
    height: 1fr;
    min-height: 8;
}

#reveal-transits {
    width: 1fr;
    height: auto;
    padding: 1 2;
    align-horizontal: center;
}

/* `Center` cannot centre a `Static`: it fills the width it is given, so
 * the box is already centred and the text inside it sits at the left. The
 * text has to be told directly. */
#reveal-caption,
#reveal-hint {
    text-align: center;
}

#reveal-hint {
    color: $syz-ember;
    text-style: bold;
}

/* Reading (M12.5c).
 *
 * Two columns from the ideal size upward, stacked only at `-compact`.
 * The threshold is lower than `-wide` on purpose: what needs 120 columns
 * is *three* regions side by side on the home screen, and applying that
 * number here too would have cost the reading its card art at 100x32 for
 * no reason. The tiers are shared; which one a given screen changes shape
 * at is a question about that screen's content.
 *
 * Stacked, the card took the screen and left the interpretation - the
 * thing the user came for - about two rows to scroll in.
 */

#reading-columns {
    layout: horizontal;
    height: 1fr;
}

/* Wide enough for `TarotCardWidget`'s 33 columns plus the padding around
 * it: the card is a fixed object, so it gets a fixed column and the
 * reading gets everything else. */
#reading-aside {
    layout: vertical;
    width: 37;
    height: 1fr;
    padding: 1 2 0 2;
}

#reading-transits {
    width: 1fr;
    height: auto;
    padding: 1 0 0 2;
}

#reading-main {
    width: 1fr;
    height: 1fr;
}

.-compact #reading-columns {
    layout: vertical;
}

.-compact #reading-aside {
    layout: horizontal;
    width: 1fr;
    height: auto;
    padding: 0 1;
}

.-compact #reading-transits {
    padding: 0 0 0 2;
}

#reading-panel {
    height: 1fr;
    padding: 0 2;
}

/* Prose has a comfortable measure whatever the terminal is. Without this
 * the interpretation ran the full width of a 200-column terminal, which
 * is one long line per paragraph and unreadable. */
#reading-body {
    width: 1fr;
    max-width: 88;
}

#reading-panel {
    border-top: none;
    border-left: solid $syz-dim;
}

.-compact #reading-panel {
    border-left: none;
    border-top: solid $syz-dim;
}

/* Chart / archive */

#chart-columns {
    layout: vertical;
    height: 1fr;
    overflow-y: auto;
}

#chart-placements,
#chart-aspects {
    width: 1fr;
    height: auto;
    overflow-y: hidden;
}

#chart-body,
#chart-aspects-body {
    padding: 1 2;
}

/* Two lists side by side, each scrolling on its own - stacked, the
 * aspects sat below the fold on a screen that was three-quarters empty. */
.-wide #chart-columns {
    layout: horizontal;
    overflow-y: hidden;
}

.-wide #chart-placements,
.-wide #chart-aspects {
    height: 1fr;
    overflow-y: auto;
}

.-wide #chart-aspects {
    border-left: solid $syz-dim;
}

/* Today's cosmos (M13.1) - COSMOS in full, arranged like the chart's
 * SELF in full, so the two secondary screens read as a pair. */

#cosmos-columns {
    layout: vertical;
    height: 1fr;
    overflow-y: auto;
}

#cosmos-sky,
#cosmos-transits {
    width: 1fr;
    height: auto;
    overflow-y: hidden;
}

#cosmos-sky-body,
#cosmos-transits-body {
    padding: 1 2;
}

.-wide #cosmos-columns {
    layout: horizontal;
    overflow-y: hidden;
}

.-wide #cosmos-sky,
.-wide #cosmos-transits {
    height: 1fr;
    overflow-y: auto;
}

/* The ranked transits are the payload; the positions are the reference
 * beside them. */
.-wide #cosmos-sky {
    width: 2fr;
}

.-wide #cosmos-transits {
    width: 3fr;
    border-left: solid $syz-dim;
}

#archive-frequency {
    padding: 1 2;
}

/* Too small */

#too-small-message {
    text-align: center;
    color: $syz-accent;
}
