/* Syzygy's visual identity (DESIGN.md section 18).
 *
 * A near-black field, warm bone text, bright white for the calculated
 * (astrology, correspondences), lunar blue for the structural, oxidized
 * red for warnings, and one high-energy ember accent reserved for chance
 * and reveal - the ember is never used for anything the machine
 * calculated, only for what it did not.
 *
 * Color is never the sole carrier of meaning: states also change glyph,
 * label, or key hint.
 */

$syz-field: #0a0b0d;
$syz-panel: #131417;
$syz-bone: #e6ddc9;
$syz-muted: #8a8272;
$syz-dim: #4a4438;
/* The calculated-fact accent (M12.1). Was a solar gold (#cf9b3f); now a
 * true white, which reads as *brighter* than $syz-bone body text rather
 * than as another warm tone competing with it. Named for its role, not
 * its colour, so the next change is one line. */
$syz-accent: #ffffff;
$syz-lunar: #7ea6c9;
$syz-oxide: #8f3a2a;
$syz-ember: #ff4d1f;

Screen {
    background: $syz-field;
    color: $syz-bone;
    layout: vertical;
}

.hidden {
    display: none;
}

/* Compact mode (DESIGN.md section 18.6): below the ideal 100x32 but at
 * or above the 80x24 floor, `SyzygyScreen` sets `-compact` on itself.
 * Padding shrinks; layout and content do not change shape, so nothing
 * here can hide information, only the whitespace around it.
 */

.-compact .title-bar,
.-compact .lede,
.-compact .muted {
    padding: 0 1;
}

.-compact #chart-body,
.-compact #archive-frequency {
    padding: 0 1;
}

.title-bar {
    width: 1fr;
    padding: 0 2;
    color: $syz-accent;
    text-style: bold;
    border-bottom: solid $syz-dim;
}

.lede {
    color: $syz-bone;
    text-style: bold;
    padding: 1 2 0 2;
}

.muted {
    color: $syz-muted;
    padding: 0 2;
}

.keys {
    color: $syz-lunar;
    padding: 1 2;
}

.error {
    color: $syz-ember;
    padding: 0 2;
}

.ok {
    color: $syz-lunar;
    padding: 0 2;
}

.section-heading {
    color: $syz-accent;
    text-style: bold;
    padding: 1 2 0 2;
}

.field-label {
    color: $syz-muted;
    padding: 1 2 0 2;
}

.button-row {
    height: auto;
    padding: 1 2;
}

Button {
    margin: 0 2 0 0;
}

Footer {
    background: $syz-panel;
    color: $syz-muted;
}

Input {
    margin: 0 2;
    background: $syz-panel;
    border: tall $syz-dim;
}

Input:focus {
    border: tall $syz-accent;
}

ListView {
    background: $syz-field;
    padding: 0 2;
}

ListItem {
    background: $syz-field;
    padding: 0 1;
}

ListItem.--highlight {
    background: $syz-panel;
    color: $syz-accent;
}

AlignmentWidget {
    /* Two content rows (labels + axis) plus one row of padding above and
       below - `height` is the whole box, padding included. */
    padding: 1 2;
    height: 4;
}

.transit-badge {
    width: auto;
    height: 1;
    margin: 0 2 0 0;
    color: $syz-accent;
}

.transit-badge.applying {
    text-style: bold;
}

.transit-badge.separating {
    color: $syz-muted;
}

TarotCardWidget {
    width: 33;
    height: 28;
    padding: 1 2;
    content-align: center middle;
    text-align: center;
    border: double $syz-accent;
    background: $syz-panel;
}

/* Welcome */

#welcome-banner {
    color: $syz-accent;
    width: auto;
}

#welcome-body {
    width: auto;
    padding: 1 0;
}

/* Profile creation */

#profile-form {
    height: 1fr;
}

#profile-confirm {
    height: auto;
    padding: 1 0;
}

#confirm-body {
    padding: 0 2;
    color: $syz-bone;
}

/* Dev-only reroll (M11.6) - only ever visible with SYZYGY_DEV set. */

#home-dev {
    padding: 1 2 0 2;
}

#home-reroll-confirm {
    height: auto;
    padding: 1 0;
}

#reroll-body {
    padding: 0 2;
}

/* Local-model setup (M11.3) */

#model-body {
    height: 1fr;
}

#model-message {
    height: auto;
    max-height: 5;
}

#llama-form {
    height: auto;
    padding: 1 0;
}

#llama-help {
    padding: 1 2;
}

/* Profile selection and deletion (M11.2) */

#profile-select-body {
    height: 1fr;
}

#profile-delete-confirm {
    height: auto;
    padding: 1 0;
}

#delete-body {
    padding: 0 2;
    color: $syz-bone;
}

/* Home */

#home-body {
    height: auto;
    padding: 1 0;
}

#home-anchors {
    height: auto;
    padding: 0 2;
}

#home-anchors Glyph {
    width: auto;
    margin: 0 3 0 0;
    color: $syz-lunar;
}

#home-transits {
    height: auto;
    padding: 1 2 0 2;
}

#primary-action {
    margin: 1 0;
    background: $syz-panel;
    color: $syz-ember;
    border: tall $syz-ember;
    text-style: bold;
}

#primary-action:hover {
    background: $syz-oxide;
    color: $syz-bone;
}

/* The Wheel */

#wheel-body {
    height: 1fr;
}

#wheel {
    height: 1fr;
    min-height: 9;
}

#wheel-status {
    color: $syz-muted;
    text-align: center;
}

/* The card (M11.5).
 *
 * Explicit boxes, not `height: auto`. `TarotCardWidget` sizes its
 * illustration from its own cell box, so an auto-sized card would be
 * deciding its height from content whose height depends on that box.
 * Fixing the frame also stops the surrounding text reflowing every time
 * the terminal is resized. The art fills whatever is left after
 * `TarotCardWidget.TEXT_ROWS`, at the source illustration's own aspect
 * ratio, and falls back to the text card when the box gets too small.
 */

#reveal-card {
    height: 28;
}

#reading-card {
    height: 24;
}

/* Below the ideal 100x32 the full-height card would push the rest of the
 * screen off the bottom. The art shrinks with the box and drops out
 * entirely (leaving the text card) once it would be illegible. */
.-compact #reveal-card {
    height: 20;
}

.-compact #reading-card {
    height: 18;
}

/* Reveal */

#reveal-body {
    height: 1fr;
    padding: 1 0;
}

#reveal-transits {
    height: auto;
    padding: 1 2;
}

#reveal-hint {
    color: $syz-ember;
    text-style: bold;
}

/* Reading */

#reading-header {
    height: auto;
    padding: 0 0 1 0;
}

#reading-summary {
    height: auto;
    padding: 1 2 0 2;
}

#reading-transits {
    width: 1fr;
    height: auto;
    padding: 1 0 0 3;
}

#reading-panel {
    height: 1fr;
    padding: 0 2;
    border-top: solid $syz-dim;
}

#reading-body {
    width: 1fr;
}

/* Chart / archive */

#chart-body {
    padding: 1 2;
}

#archive-frequency {
    padding: 1 2;
}

/* Too small */

#too-small-message {
    text-align: center;
    color: $syz-accent;
}
